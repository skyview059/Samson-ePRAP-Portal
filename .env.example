# Copy this file to .env on each server (root of the project, next to
# index.php) and fill in real values. .env itself is gitignored — never
# commit real credentials. Not present at all is fine too: everything
# falls back to the previous hardcoded defaults.

CI_ENV=production

DB_HOSTNAME=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=eprap

BASE_URL=https://eprap.test/
BACKEND_URL=admin

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_CURRENCY=GBP
STRIPE_ENABLE=false

FW_PUBLIC_KEY=
FW_SECRET_KEY=

PAYPAL_ENABLE=false

SMTP_HOST=mail.eprap.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# DigitalOcean Spaces (S3-compatible) file storage. Leave DO_SPACES_ENABLED
# unset/false to keep using local disk (e.g. on a single-server setup).
DO_SPACES_ENABLED=false
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=eprap
DO_SPACES_REGION=lon1
DO_SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com
DO_SPACES_CDN_URL=https://eprap.lon1.cdn.digitaloceanspaces.com
# false for real DO Spaces; true only for an endpoint with no wildcard DNS
# for bucket subdomains (e.g. local MinIO for dev/testing).
DO_SPACES_PATH_STYLE=false
# Subfolder within the bucket, for sharing one bucket across projects.
# Leave blank to store files at the bucket root.
DO_SPACES_FOLDER=eprap
